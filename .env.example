# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# Настоящие значения никогда не коммитятся (.env* в .gitignore).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Только для применения миграций с этого компьютера (в Vercel не добавлять).
# Supabase → кнопка Connect → Session pooler. Подставьте пароль базы.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
